// Consent — Likeness & IP Permission Platform
// Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Users, auth, sessions
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerified DateTime?
  passwordHash  String
  name          String
  totpSecret    String? // enabled when set + totpEnabled
  totpEnabled   Boolean   @default(false)
  isSuspended   Boolean   @default(false)
  isBanned      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions             Session[]
  otpCodes             OtpCode[]
  adminRoleId          String?
  adminRole            AdminRole?            @relation(fields: [adminRoleId], references: [id])
  consenterMembers     ConsenterMember[]
  requesterMembers     RequesterMember[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  notifPrefs           NotificationPref?
  decisions            ConsentRequest[]      @relation("decidedBy")
  messages             RequestMessage[]
  uploadedFiles        StoredFile[]
  verificationMeetings VerificationMeeting[] @relation("officer")
  scoreAdjustments     ScoreLog[]            @relation("adjustedBy")
  appInvites           AppInvite[]
}

// Invite a person/IP who isn't on Consent yet (searched but not found).
// Multiple invites for the same name measure demand; claimed when the
// entity signs up and creates a consenter profile.
model AppInvite {
  id                   String    @id @default(cuid())
  targetName           String
  normalizedName       String
  email                String?
  handle               String?
  note                 String?
  invitedById          String
  invitedBy            User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  claimedAt            DateTime?
  claimedByConsenterId String?
  createdAt            DateTime  @default(now())

  @@unique([invitedById, normalizedName])
  @@index([normalizedName])
  @@index([email])
}

model Session {
  id            String   @id // token hash
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  totpPassed    Boolean  @default(false)
  // active profile context: "consenter:<id>" | "requester:<id>" | "admin" | null
  activeProfile String?
  createdAt     DateTime @default(now())
  ip            String?
  userAgent     String?
}

enum OtpPurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  LOGIN
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  purpose   OtpPurpose
  target    String // email or phone it was sent to
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())
}

// ─────────────────────────────────────────────────────────────
// Admin RBAC
// ─────────────────────────────────────────────────────────────

model AdminRole {
  id           String   @id @default(cuid())
  name         String   @unique
  isSuperAdmin Boolean  @default(false)
  // permissions: { module: ["view","create","edit","approve","delete","export"] }
  permissions  Json     @default("{}")
  users        User[]
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Profiles
// ─────────────────────────────────────────────────────────────

enum ConsenterEntityType {
  PERSON
  TV_SHOW
  MOVIE
  WEB_SERIES
  BRAND
  FICTIONAL_CHARACTER
  BAND_GROUP
  SPORTS_TEAM
  OTHER
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFO_NEEDED
  APPROVED // requester approved / consenter verified
  REJECTED
}

model ConsenterProfile {
  id                   String              @id @default(cuid())
  slug                 String              @unique
  displayName          String
  legalName            String
  normalizedLegalName  String
  entityType           ConsenterEntityType
  aliases              String[]            @default([])
  bio                  String?
  photoFileId          String?
  country              String
  category             String?
  status               VerificationStatus  @default(DRAFT)
  verifiedAt           DateTime?
  documentNumberHash   String? // for duplicate detection
  duplicateFlag        Boolean             @default(false)
  adminNotes           String?
  // Consent request fee: what someone pays IN-APP to ask this profile. Held
  // until the answer: 80% to this profile on a yes, 80% refunded otherwise.
  // null = free to ask. A paid fee is at least Currency.minConsentFee.
  consentPrice         Decimal?            @db.Decimal(14, 2)
  consentPriceCurrency String              @default("INR")
  payoutDetails        String? // where weekly settlements are paid (bank/UPI/PayPal note)
  // Request limits the owner chooses (null = no limit). New requests are paused
  // while any limit is reached.
  maxOpenRequests      Int? // requests waiting for their first answer, at once
  dailyRequestLimit    Int? // new requests in any 24 hours
  weeklyRequestLimit   Int? // new requests in any 7 days
  monthlyRequestLimit  Int? // new requests in any 30 days
  score                Int                 @default(500)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  members        ConsenterMember[]
  documents      StoredFile[]          @relation("consenterDocs")
  socialAccounts SocialAccount[]
  matrixEntries  ConsentMatrixEntry[]
  standingRules  StandingRule[]
  blacklist      ListEntry[]           @relation("blacklistOf")
  requests       ConsentRequest[]
  meetings       VerificationMeeting[]
  scoreLogs      ScoreLog[]            @relation("consenterScore")
  earnings       EarningEntry[]
  settlements    Settlement[]
  priceTiers     ConsentPriceTier[]
  tipOffs        PublicTipOff[]
  // Every profile can both receive and send. This is its sending half:
  // created together with it, same name, same verification.
  asker          RequesterProfile?     @relation("asksAs")

  @@index([normalizedLegalName])
  @@index([status])
}

// Per-intent consent price override: news can be free while commercial costs.
// Falls back to ConsenterProfile.consentPrice when no tier matches.
model ConsentPriceTier {
  id               String           @id @default(cuid())
  consenterId      String
  consenter        ConsenterProfile @relation(fields: [consenterId], references: [id], onDelete: Cascade)
  intentCategoryId String
  intentCategory   IntentCategory   @relation(fields: [intentCategoryId], references: [id], onDelete: Cascade)
  amount           Decimal          @db.Decimal(14, 2)

  @@unique([consenterId, intentCategoryId])
}

enum TipOffStatus {
  OPEN
  REVIEWED
  DISMISSED
}

// Public tip-off: anyone (no account) can report unauthorized use of a
// consenter's likeness from their public profile.
model PublicTipOff {
  id            String           @id @default(cuid())
  consenterId   String
  consenter     ConsenterProfile @relation(fields: [consenterId], references: [id], onDelete: Cascade)
  links         String[]
  description   String
  reporterName  String?
  reporterEmail String?
  status        TipOffStatus     @default(OPEN)
  adminNote     String?
  createdAt     DateTime         @default(now())

  @@index([consenterId, status])
  @@index([status])
}

enum RequesterType {
  INDIVIDUAL_CREATOR
  NEWS_CHANNEL
  PODCAST
  MEME_PAGE
  MEDIA_HOUSE
  AGENCY
  OTHER
}

// The sending half of a profile. Every ConsenterProfile has exactly one
// (consenterId), created with it and kept in step (name, country, status).
model RequesterProfile {
  id               String             @id @default(cuid())
  consenterId      String?            @unique
  consenter        ConsenterProfile?  @relation("asksAs", fields: [consenterId], references: [id], onDelete: Cascade)
  slug             String             @unique
  displayName      String
  legalName        String
  type             RequesterType
  country          String
  description      String?
  categories       String[]           @default([])
  channels         Json               @default("[]") // [{platform, url, followers}]
  status           VerificationStatus @default(DRAFT)
  approvedAt       DateTime?
  adminNotes       String?
  score            Int                @default(500)
  // Yearly membership, paid only while the admin has the membership fee on.
  membershipEndsAt DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  members        RequesterMember[]
  documents      StoredFile[]      @relation("requesterDocs")
  socialAccounts SocialAccount[]
  requests       ConsentRequest[]
  listEntries    ListEntry[]       @relation("aboutRequester")
  payments       Payment[]
  scoreLogs      ScoreLog[]        @relation("requesterScore")

  @@index([status])
}

enum TeamRole {
  OWNER
  MANAGER
  EDITOR // the sending half's mirror of MANAGER
  VIEWER
}

model ConsenterMember {
  id            String           @id @default(cuid())
  consenterId   String
  consenter     ConsenterProfile @relation(fields: [consenterId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          TeamRole
  canApprove    Boolean          @default(false)
  canEditRules  Boolean          @default(false)
  canExport     Boolean          @default(false)
  canManageTeam Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@unique([consenterId, userId])
}

model RequesterMember {
  id          String           @id @default(cuid())
  requesterId String
  requester   RequesterProfile @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        TeamRole
  createdAt   DateTime         @default(now())

  @@unique([requesterId, userId])
}

model TeamInvite {
  id            String    @id @default(cuid())
  profileKind   String // "consenter" (the profile); "requester" only on old invites
  profileId     String
  email         String
  role          TeamRole
  canApprove    Boolean   @default(false)
  canEditRules  Boolean   @default(false)
  canExport     Boolean   @default(false)
  canManageTeam Boolean   @default(false)
  token         String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
}

model SocialAccount {
  id           String    @id @default(cuid())
  platformName String
  handle       String
  url          String?
  followers    Int?
  verifiedVia  String // "oauth" | "manual"
  proofFileId  String?
  verifiedAt   DateTime?

  consenterId String?
  consenter   ConsenterProfile? @relation(fields: [consenterId], references: [id], onDelete: Cascade)
  requesterId String?
  requester   RequesterProfile? @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
}

enum MeetingMode {
  VIDEO
  IN_PERSON
}

model VerificationMeeting {
  id          String           @id @default(cuid())
  consenterId String
  consenter   ConsenterProfile @relation(fields: [consenterId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  mode        MeetingMode
  link        String?
  location    String?
  officerId   String?
  officer     User?            @relation("officer", fields: [officerId], references: [id])
  outcome     String? // "passed" | "failed" | null
  notes       String?
  createdAt   DateTime         @default(now())
}

// ─────────────────────────────────────────────────────────────
// Catalog (admin-editable)
// ─────────────────────────────────────────────────────────────

model Platform {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  formats   Format[]
}

model Format {
  id         String   @id @default(cuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  name       String
  isTimed    Boolean  @default(false) // duration applies
  active     Boolean  @default(true)

  @@unique([platformId, name])
}

model AssetType {
  id        String  @id @default(cuid())
  name      String  @unique
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model IntentCategory {
  id         String             @id @default(cuid())
  name       String             @unique
  active     Boolean            @default(true)
  priceTiers ConsentPriceTier[]
}

model DenialReason {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)
}

// ─────────────────────────────────────────────────────────────
// Consent settings
// ─────────────────────────────────────────────────────────────

enum MatrixPolicy {
  AUTO_APPROVE
  ASK
  AUTO_DENY
}

model ConsentMatrixEntry {
  id               String           @id @default(cuid())
  consenterId      String
  consenter        ConsenterProfile @relation(fields: [consenterId], references: [id], onDelete: Cascade)
  platformId       String
  formatId         String
  assetTypeId      String
  policy           MatrixPolicy     @default(ASK)
  maxDurationSec   Int?
  thumbnailAllowed Boolean          @default(true)

  @@unique([consenterId, platformId, formatId, assetTypeId])
}

enum RuleAction {
  AUTO_APPROVE
  AUTO_DENY
  ROUTE_TO_MEMBER
}

model StandingRule {
  id            String           @id @default(cuid())
  consenterId   String
  consenter     ConsenterProfile @relation(fields: [consenterId], references: [id], onDelete: Cascade)
  name          String
  priority      Int
  active        Boolean          @default(true)
  // conditions: {platformIds?, formatIds?, assetTypeIds?, maxDurationSec?, requesterTypes?, minScore?, categories?, whitelistOnly?}
  conditions    Json
  action        RuleAction
  routeToUserId String?
  createdById   String
  createdByName String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

enum ListKind {
  BLACKLIST
  WHITELIST
}

model ListEntry {
  id          String           @id @default(cuid())
  kind        ListKind
  consenterId String
  consenter   ConsenterProfile @relation("blacklistOf", fields: [consenterId], references: [id], onDelete: Cascade)
  requesterId String
  requester   RequesterProfile @relation("aboutRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  note        String?
  createdAt   DateTime         @default(now())

  @@unique([kind, consenterId, requesterId])
}

// ─────────────────────────────────────────────────────────────
// Files
// ─────────────────────────────────────────────────────────────

enum FileKind {
  DOCUMENT
  ASSET
  RAW_CONTENT
  THUMBNAIL
  ATTACHMENT
  EVIDENCE
  PROFILE_PHOTO
}

model StoredFile {
  id              String            @id @default(cuid())
  kind            FileKind
  name            String
  mime            String
  size            Int
  sha256          String
  storageKey      String
  version         Int               @default(1)
  uploadedById    String?
  uploadedBy      User?             @relation(fields: [uploadedById], references: [id])
  requestId       String?
  request         ConsentRequest?   @relation(fields: [requestId], references: [id])
  replacesId      String? // previous version
  approvedInGrant Boolean           @default(false)
  consenterDocOf  String?
  consenterDoc    ConsenterProfile? @relation("consenterDocs", fields: [consenterDocOf], references: [id])
  requesterDocOf  String?
  requesterDoc    RequesterProfile? @relation("requesterDocs", fields: [requesterDocOf], references: [id])
  createdAt       DateTime          @default(now())

  @@index([requestId])
  @@index([sha256])
}

// ─────────────────────────────────────────────────────────────
// Consent requests
// ─────────────────────────────────────────────────────────────

enum RequestStatus {
  DRAFT
  SUBMITTED
  PENDING
  CHANGES_REQUESTED // the owner asked a question; the requester answers
  APPROVED_IN_PRINCIPLE // yes, waiting for the final content file the certificate binds to
  APPROVED
  DENIED
  CLOSED
  EXPIRED_NO_RESPONSE
  WITHDRAWN
}

enum ValidityKind {
  SINGLE_PUBLICATION
  DATE_RANGE
  PERPETUAL
}

model ConsentRequest {
  id          String           @id @default(cuid())
  number      Int              @unique @default(autoincrement())
  requesterId String
  requester   RequesterProfile @relation(fields: [requesterId], references: [id])
  consenterId String
  consenter   ConsenterProfile @relation(fields: [consenterId], references: [id])
  status      RequestStatus    @default(DRAFT)

  // scope
  selections         Json // [{platformId, platformName, formatId, formatName, durationSec?}]
  assetTypeIds       String[]
  assetTypeNames     String[]
  thumbnailUsed      Boolean      @default(false)
  context            String
  creativePlan       String
  intentCategoryId   String?
  intentCategoryName String?
  validityKind       ValidityKind
  validFrom          DateTime?
  validUntil         DateTime?
  plannedPublishAt   DateTime?

  // conditions applied by consenter on approval
  conditionsNote     String?
  approvedSelections Json? // possibly reduced scope
  approvedThumbnail  Boolean?

  // lifecycle
  submittedAt       DateTime?
  decidedAt         DateTime?
  decidedById       String?
  decidedBy         User?     @relation("decidedBy", fields: [decidedById], references: [id])
  decidedByRuleId   String?
  decidedByRuleName String?
  denialReason      String?
  slaExpiresAt      DateTime?
  reminder50Sent    Boolean   @default(false)
  reminder90Sent    Boolean   @default(false)
  remindedAt        DateTime? // last "about to expire" reminder; one per 7-day window
  closedReason      String?

  files    StoredFile[]
  messages RequestMessage[]
  grant    Grant?
  payments Payment[]
  earning  EarningEntry?
  reports  Report[]
  events   RequestEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consenterId, status])
  @@index([requesterId, status])
}

model RequestEvent {
  id        String         @id @default(cuid())
  requestId String
  request   ConsentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type      String
  actorName String?
  actorSide String? // "consenter"|"requester"|"admin"|"system"
  detail    Json?
  createdAt DateTime       @default(now())

  @@index([requestId])
}

model RequestMessage {
  id               String         @id @default(cuid())
  requestId        String
  request          ConsentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User           @relation(fields: [senderId], references: [id])
  senderSide       String // "consenter"|"requester"
  body             String
  attachmentFileId String?
  createdAt        DateTime       @default(now())
}

// ─────────────────────────────────────────────────────────────
// Grants & certificates
// ─────────────────────────────────────────────────────────────

enum GrantStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Grant {
  id             String            @id @default(cuid())
  publicId       String            @unique // short id for /v/{id}
  requestId      String            @unique
  request        ConsentRequest    @relation(fields: [requestId], references: [id])
  status         GrantStatus       @default(ACTIVE)
  validityKind   ValidityKind
  validFrom      DateTime?
  validUntil     DateTime?
  expiryNotified Boolean           @default(false)
  revokedAt      DateTime?
  revokeReason   String?
  // certificate
  certificateId  String            @unique
  payload        Json // canonical certificate payload
  signature      String // ed25519 over canonical JSON, base64
  publicKey      String
  issuedAt       DateTime          @default(now())
  issuedByName   String
  takedowns      TakedownRequest[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

enum TakedownStatus {
  RAISED
  MARKED_DOWN
  DECLINED
  CONFIRMED
  REJECTED_CLAIM
  IGNORED
}

model TakedownRequest {
  id                      String         @id @default(cuid())
  grantId                 String
  grant                   Grant          @relation(fields: [grantId], references: [id], onDelete: Cascade)
  reason                  String
  liveLinks               String[]
  status                  TakedownStatus @default(RAISED)
  requesterNote           String?
  requesterEvidenceFileId String?
  declineReason           String?
  respondBy               DateTime
  respondedAt             DateTime?
  confirmedAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Payments: the yearly membership, and per request the consent request fee
// (held, 80/20) plus the platform fee (20% of it, never refunded)
// ─────────────────────────────────────────────────────────────

enum PaymentPurpose {
  MEMBERSHIP // the yearly membership (only charged while the admin has the fee on)
  PER_REQUEST // the platform fee: 20% of the consent request fee, never refunded
  CONSENT_PRICE // the consent request fee: held until the answer, 80/20
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  FORFEITED
  REFUNDED // consent price returned to the requester (no yes from the owner)
}

model Payment {
  id             String           @id @default(cuid())
  requesterId    String
  requester      RequesterProfile @relation(fields: [requesterId], references: [id])
  purpose        PaymentPurpose
  amount         Decimal          @db.Decimal(14, 2)
  currency       String
  provider       String // "mock" | "stripe" | "razorpay"
  providerRef    String?
  status         PaymentStatus    @default(PENDING)
  couponCode     String?
  discount       Decimal?         @db.Decimal(14, 2)
  tax            Decimal?         @db.Decimal(14, 2)
  taxLabel       String?
  requestId      String?
  request        ConsentRequest?  @relation(fields: [requestId], references: [id])
  invoiceNumber  String?          @unique
  paidAt         DateTime?
  refundedAt     DateTime?
  refundRef      String?
  refundedAmount Decimal?         @db.Decimal(14, 2) // the part returned (80% of a consent request fee)
  createdAt      DateTime         @default(now())
  earning        EarningEntry?

  @@index([requestId])
}

// ── Consenter earnings & weekly settlements ───────────────────

enum EarningStatus {
  HELD // collected in-app, held until the owner answers
  PENDING // owner said yes: theirs, awaiting the weekly settlement
  SETTLED // paid out in a weekly settlement batch
  REFUNDED // no yes (declined, withdrawn, ended, expired): returned to the requester
  REVERSED // legacy: auto-expired before refunds existed
}

model EarningEntry {
  id             String           @id @default(cuid())
  consenterId    String
  consenter      ConsenterProfile @relation(fields: [consenterId], references: [id], onDelete: Cascade)
  requestId      String           @unique
  request        ConsentRequest   @relation(fields: [requestId], references: [id])
  paymentId      String           @unique
  payment        Payment          @relation(fields: [paymentId], references: [id])
  amount         Decimal          @db.Decimal(14, 2) // the owner's share (80% of the fee), what a yes pays out
  grossAmount    Decimal?         @db.Decimal(14, 2) // the full consent request fee the requester paid
  currency       String
  status         EarningStatus    @default(HELD)
  reversedReason String?
  settlementId   String?
  settlement     Settlement?      @relation(fields: [settlementId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([consenterId, status])
}

model Settlement {
  id          String           @id @default(cuid())
  consenterId String
  consenter   ConsenterProfile @relation(fields: [consenterId], references: [id], onDelete: Cascade)
  amount      Decimal          @db.Decimal(14, 2)
  currency    String
  periodStart DateTime
  periodEnd   DateTime
  reference   String // payout reference (mock provider in dev)
  entries     EarningEntry[]
  createdAt   DateTime         @default(now())

  @@index([consenterId])
}

// Per country: the yearly membership price and the tax added to Consent's
// own fees (membership and platform fee).
model PriceConfig {
  id            String   @id @default(cuid())
  country       String // ISO code or "DEFAULT"
  currency      String
  membershipFee Decimal  @db.Decimal(14, 2) // per year; charged only while the fee is switched on
  taxLabel      String?
  taxRate       Decimal? @db.Decimal(5, 2)

  @@unique([country])
}

// Currencies a consent request fee can be set in, and the smallest paid fee
// in each (about ₹100). Free is always allowed. Admin-editable.
model Currency {
  code          String  @id // ISO 4217, e.g. "INR"
  name          String
  minConsentFee Decimal @db.Decimal(14, 2)
  active        Boolean @default(true)
  sortOrder     Int     @default(0)
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int
  active     Boolean   @default(true)
  expiresAt  DateTime?
  maxUses    Int?
  usedCount  Int       @default(0)
}

// ─────────────────────────────────────────────────────────────
// Reports & scores
// ─────────────────────────────────────────────────────────────

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  UPHELD
  DISMISSED
}

model Report {
  id              String         @id @default(cuid())
  requestId       String
  request         ConsentRequest @relation(fields: [requestId], references: [id])
  bySide          String // reporter side
  reason          String // category
  description     String
  evidenceLinks   String[]
  evidenceFileIds String[]
  status          ReportStatus   @default(OPEN)
  response        String? // other party's response
  adminNotes      String?
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ScoreLog {
  id           String            @id @default(cuid())
  consenterId  String?
  consenter    ConsenterProfile? @relation("consenterScore", fields: [consenterId], references: [id], onDelete: Cascade)
  requesterId  String?
  requester    RequesterProfile? @relation("requesterScore", fields: [requesterId], references: [id], onDelete: Cascade)
  oldScore     Int
  newScore     Int
  reason       String
  adjustedById String?
  adjustedBy   User?             @relation("adjustedBy", fields: [adjustedById], references: [id])
  createdAt    DateTime          @default(now())
}

// ─────────────────────────────────────────────────────────────
// System: settings, audit, jobs, notifications, CMS, templates
// ─────────────────────────────────────────────────────────────

model Setting {
  key   String @id
  value Json
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  actorName String
  action    String
  module    String
  targetId  String?
  detail    Json?
  reason    String?
  ip        String?
  prevHash  String
  hash      String // sha256(prevHash + canonical entry)
  createdAt DateTime @default(now())

  @@index([module])
  @@index([actorId])
}

model Job {
  id        String    @id @default(cuid())
  type      String
  payload   Json      @default("{}")
  runAt     DateTime
  attempts  Int       @default(0)
  lockedAt  DateTime?
  doneAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([runAt, doneAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model NotificationPref {
  userId            String  @id
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailStateChanges Boolean @default(true)
  smsCritical       Boolean @default(true)
}

// Mock outbox for email/SMS in dev ("dev inbox")
model OutboxMessage {
  id        String   @id @default(cuid())
  channel   String // "email"|"sms"
  to        String
  subject   String?
  body      String
  createdAt DateTime @default(now())
}

model CmsPage {
  slug      String   @id
  title     String
  body      String // markdown
  updatedAt DateTime @updatedAt
}

model MessageTemplate {
  key     String  @id
  channel String // "email"|"sms"
  subject String?
  body    String
}

model ExportLog {
  id        String   @id @default(cuid())
  kind      String // "dossier"
  scope     String
  byUserId  String?
  byName    String
  createdAt DateTime @default(now())
}
